{
  "name": "pi-frame",
  "private": true,
  "version": "0.2.0-beta.6",
  "description": "Codex-style Electron desktop workspace for the pi coding agent.",
  "repository": {
    "type": "git",
    "url": "https://github.com/pi-frame/pi-frame.git"
  },
  "homepage": "https://github.com/pi-frame/pi-frame",
  "license": "MIT",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "version:bump": "node scripts/auto-version.mjs",
    "dev": "pnpm --filter @pi-frame/desktop dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm --filter @pi-frame/session-driver build && pnpm --filter @pi-frame/catalogs build && pnpm --filter @pi-frame/pi-sdk-driver build && pnpm -r --if-present typecheck",
    "package:mac": "pnpm --filter @pi-frame/desktop run package:mac",
    "package:mac:dir": "pnpm --filter @pi-frame/desktop run package:mac:dir",
    "package:linux": "pnpm --filter @pi-frame/desktop run package:linux",
    "package:win": "pnpm --filter @pi-frame/desktop run package:win",
    "package:win:dir": "pnpm --filter @pi-frame/desktop run package:win:dir",
    "lint": "pnpm -r --if-present lint",
    "test": "node scripts/test-changed.mjs",
    "test:changed": "node scripts/test-changed.mjs",
    "test:changed:list": "node scripts/test-changed.mjs --list",
    "test:changed:unit": "node --test scripts/test-changed.test.mjs",
    "test:all": "pnpm run test:changed:unit && pnpm --filter @pi-frame/pi-sdk-driver test && pnpm --filter @pi-frame/desktop test:e2e:core",
    "e2e": "playwright test",
    "verify:install-copy": "node scripts/verify-install-copy.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^24.0.0",
    "pnpm": "10.25.0",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "video"
  ]
}
